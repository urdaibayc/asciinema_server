# Application Metrics Dashboard (Placeholder)
# This is a basic application metrics dashboard template

apiVersion: 1
kind: Dashboard
dashboard:
  title: Application Metrics
  panels:
    - title: HTTP Requests
      type: graph
      targets:
        - expr: "rate(http_requests_total[5m])"
          legendFormat: "Requests per second"
      gridPos:
        x: 0
        y: 0
        w: 12
        h: 8
    - title: Response Time
      type: graph
      targets:
        - expr: "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))"
          legendFormat: "95th percentile"
      gridPos:
        x: 12
        y: 0
        w: 12
        h: 8
    - title: Error Rate
      type: stat
      targets:
        - expr: "sum(rate(http_requests_total{status="500"}[5m])) / sum(rate(http_requests_total[5m])) * 100"
          legendFormat: "Error rate %"
      gridPos:
        x: 0
        y: 8
        w: 12
        h: 8
    - title: Active Sessions
      type: stat
      targets:
        - expr: "sum(http_sessions_active)"
          legendFormat: "Active sessions"
      gridPos:
        x: 12
        y: 8
        w: 12
        h: 8

dashboard: {}
